# This profile uses only stock D2 shapes and labels, not a custom port keyword.
direction: right
classes: {
  hx-block: {style.fill: "#eef3fa"}
  hx-input: {
    shape: circle
    width: 10
    height: 10
    label.near: outside-right-center
    style.fill: "#3979b9"
  }
  hx-output: {
    shape: circle
    width: 10
    height: 10
    label.near: outside-left-center
    style.fill: "#bd6b22"
  }
  hx-wire: {}
  hx-exposure: {style.stroke-dash: 3}
}

import sys
from typing import overload

class A:
    @overload
    def get(self, key: int) -> int: ...
    @overload
    def get(self, key: str) -> str: ...
    @overload
    def get(self, key: float) -> float: ...

class B:
    @overload
    def get(self, key: int) -> int: ...
    @overload
    def get(self, key: str) -> str: ...

@overload
def fetch(key: int) -> int: ...
@overload
def fetch(key: str) -> str: ...
@overload
def fetch(key: float) -> float: ...

if sys.version_info >= (3, 12):
    def plain(key: int) -> int: ...
else:
    def plain(key: int) -> int: ...

...@pins
source: Source {
  class: hx-block
  link: "hx:rs:src/lib.rs::produce"
  in_sample: "seed: u32" {class: hx-input; link: "hx:rs:src/lib.rs::produce"}
  in_valid: "enabled: bool" {class: hx-input; link: "hx:rs:src/lib.rs::produce"}
  out_sample: "sample: u32" {class: hx-output; link: "hx:rs:src/lib.rs::produce"}
  out_valid: "valid: bool" {class: hx-output; link: "hx:rs:src/lib.rs::produce"}
}
sink: Sink {
  class: hx-block
  link: "hx:rs:src/lib.rs::consume"
  # Opposite declaration order makes the endpoint identity significant.
  in_valid: "valid: bool" {class: hx-input; link: "hx:rs:src/lib.rs::consume"}
  in_sample: "sample: u32" {class: hx-input; link: "hx:rs:src/lib.rs::consume"}
  out_sample: "result: u32" {class: hx-output; link: "hx:rs:src/lib.rs::consume"}
  out_valid: "accepted: bool" {class: hx-output; link: "hx:rs:src/lib.rs::consume"}
}
source.out_sample -> sink.in_sample: data {class: hx-wire}
source.out_valid -> sink.in_valid: status {class: hx-wire}
